# Optional. Default is 43123.
PORT=43123

# Optional. If unset, a secret is created in DATA_DIR/auth-secret.txt
# and reused so teacher logins survive a restart.
# Set this in any hosted deployment.
AUTH_SECRET=

# Optional. Where the SQLite database and uploads are stored.
# Mount a persistent disk here when you deploy.
DATA_DIR=./data

# Optional. Absolute public origin encoded in the student upload QR.
# Leave unset on the live site: the QR uses the address in the browser.
# Railway also reads RAILWAY_PUBLIC_DOMAIN when this is empty.
# PUBLIC_URL=https://tongchung-production.up.railway.app
